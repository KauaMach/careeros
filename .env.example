# Ambiente
NODE_ENV=development
ENVIRONMENT=development

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend (FastAPI)
# Usando asyncpg para SQLAlchemy 2.0 Async
DATABASE_URL=postgresql+asyncpg://careeeros:careeeros_password@localhost:5432/careeeros

# Redis (Cache & Celery)
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO local)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=careeeros
MINIO_SECURE=false

# Autenticação JWT
JWT_SECRET_KEY=change-me-in-production-with-a-very-long-secure-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Chave para criptografar as chaves de API de IA no banco de dados (Fernet)
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# Configurações de IA padrão (O usuário vai configurar na tela de UI, isso é só fallback)
AI_PROVIDER=ollama
AI_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
